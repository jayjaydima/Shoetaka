PORT=8080

# Database mode: local (default) or tidb
# Keep local mode for XAMPP development.
DB_MODE=local

# LOCAL MySQL / XAMPP connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shoe_inventory_db

# ONLINE TiDB Cloud connection (set these in Render Environment).
# Do not commit real credentials. Set DB_MODE=tidb on Render.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=shoe_inventory_db

# Firebase Admin credentials are provided separately on the hosting platform.
# Never commit serviceAccountKey.json or its private key.
