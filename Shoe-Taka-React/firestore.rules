rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly([
             'uid', 'displayName', 'email', 'photoURL',
             'phone', 'address', 'role', 'createdAt'
           ])
        && request.resource.data.createdAt == request.time;
      allow update: if (
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['displayName', 'phone', 'address', 'photoURL', 'updatedAt'])
        ) || isAdmin();
      allow delete: if false;
    }

    function validProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 120
        && p.brand is string
        && p.code is string
        && p.priceValue is number && p.priceValue >= 0
        && p.image is string
        && p.size is list && p.size.size() > 0 && p.size.size() <= 30
        && p.stock is number && p.stock >= 0
        && p.status in ['pending', 'approved', 'rejected'];
    }

    match /products/{productId} {
      allow read: if true;
      // Sellers may submit only their own pending products.
      allow create: if isSignedIn()
        && validProduct(request.resource.data)
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only admins can approve/reject or edit existing product records.
      allow update: if isAdmin() && validProduct(request.resource.data);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.sellerId == request.auth.uid
            && resource.data.status == 'pending');
    }

    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'Processing'
        && request.resource.data.keys().hasOnly([
             'userId', 'userEmail', 'orderNumber', 'status', 'items',
             'total', 'buyer', 'paymentMethod', 'placedAt', 'updatedAt'
           ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.buyer is map
        && request.resource.data.paymentMethod in ['GCash', 'Maya', 'COD']
        && request.resource.data.placedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn() && (
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['Processing', 'Shipped', 'Delivered', 'Cancelled'])
        ||
        (resource.data.userId == request.auth.uid
          && resource.data.status == 'Processing'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'Cancelled')
      );
      allow delete: if isAdmin();
    }
  }
}
